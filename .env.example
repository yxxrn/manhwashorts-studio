# ManhwaShorts Studio - configuration
#
# Copy to .env and edit. Every variable is optional: the defaults below are what
# the app uses when the file is absent, so a fresh clone runs with no config.
#
#   cp .env.example .env
#
# NEVER commit a real .env. It is already in .gitignore.

# ---------------------------------------------------------------- core
MS_ENVIRONMENT=local          # local | staging | production
MS_DEBUG=true
MS_HOST=127.0.0.1             # keep on loopback unless behind a TLS proxy
MS_PORT=8000

# ---------------------------------------------------------------- security
# Generated and persisted to data/.secret_key on first run if unset.
# Set explicitly for a stable value across deployments.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MS_SECRET_KEY=

# Fernet key encrypting OAuth tokens at rest. Persisted to data/.fernet_key
# if unset. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MS_FERNET_KEY=

MS_SESSION_MAX_AGE=604800     # 7 days, in seconds

# ---------------------------------------------------------------- storage
# MS_DATA_DIR=./data
# MS_DATABASE_URL=sqlite:///./data/manhwashorts.db
# For PostgreSQL: postgresql+psycopg://user:pass@localhost/manhwashorts

MS_MAX_UPLOAD_MB=25

# ---------------------------------------------------------------- video
MS_VIDEO_WIDTH=1080
MS_VIDEO_HEIGHT=1920
MS_VIDEO_FPS=30
MS_MAX_SHORT_SECONDS=60
MS_DEFAULT_TARGET_SECONDS=60

MS_FFMPEG_BIN=ffmpeg
MS_FFPROBE_BIN=ffprobe
MS_SUBTITLE_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ---------------------------------------------------------------- text to speech
# espeak = local, offline, robotic but free (default)
# null   = silent audio of the right length, for tests
# http   = any HTTP API returning audio bytes
MS_TTS_PROVIDER=espeak
MS_ESPEAK_BIN=espeak-ng
# MS_TTS_HTTP_URL=https://your-tts-endpoint/synthesize
# MS_TTS_HTTP_KEY=

# ---------------------------------------------------------------- language model
# rules              = deterministic heuristics, offline (default)
# openai_compatible  = any /chat/completions endpoint
#
# You usually do NOT need these: since v1.1 you can add API keys per workspace
# from the UI (BYOK), which is easier to rotate and does not need a restart. A
# verified BYOK key takes precedence over the values below. These remain useful
# for a server-wide default or an unattended deployment. See docs/BYOK.md.
MS_LLM_PROVIDER=rules
# MS_LLM_BASE_URL=https://api.openai.com/v1
# MS_LLM_API_KEY=
# MS_LLM_MODEL=gpt-4o-mini
# MS_LLM_TIMEOUT=90

# ---------------------------------------------------------------- BYOK at rest
# BYOK API keys are encrypted with this key before being stored. Generated into
# data/.fernet_key on first run if unset. Back it up with the database: losing it
# makes every stored API key and OAuth token permanently unreadable.
# MS_FERNET_KEY=

# ---------------------------------------------------------------- youtube
# Leave disabled to run in dry-run mode: the publish path works end to end but
# uploads nothing and writes a local receipt instead.
MS_YOUTUBE_ENABLED=false
# MS_YOUTUBE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# MS_YOUTUBE_CLIENT_SECRET=
MS_YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/callback

# ---------------------------------------------------------------- policy guardrails
# Requiring a rights declaration is what blocks publication of undeclared
# material. Turning it off weakens the main copyright safeguard.
MS_REQUIRE_RIGHTS_DECLARATION=true

# Guideline for how many panels from one chapter is reasonable before the app
# warns that the video may stop reading as commentary.
MS_MAX_CONSECUTIVE_PANELS_PER_CHAPTER=8

# Public uploads are refused unless this is true AND the request confirms it.
MS_ALLOW_PUBLIC_PUBLISH=false
