artifacts/

# Test scratch runs (disk-backed; /tmp is too small for real renders)
data/test_runs/

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Build artifacts
dist/
build/
node_modules/

# Downloaded installers (cloudflared etc)
*.deb
