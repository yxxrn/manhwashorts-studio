[Unit]
Description=OmniVoice CPU TTS for ManhwaShorts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/omnivoice-official
Environment=HF_HOME=%h/.cache/huggingface
Environment=OMNIVOICE_NUM_THREADS=8
ExecStart=%h/omnivoice-official/.venv312/bin/python %h/manhwashorts/scripts/omnivoice_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
